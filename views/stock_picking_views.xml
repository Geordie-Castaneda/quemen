<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record model="ir.ui.view" id="quemen_view_picking_form">
            <field name="name">quemen.stock.picking.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <field name="is_locked" position="after">
                    <field name="generar_nuevos_lotes" invisible="1"/>
                </field>
                <page name="detailed_operations" position="before">
                    <page string="Productos" name="productos" attrs="{'invisible': [('generar_nuevos_lotes', '=', False)]}">
                        <field name="producto_ids" mode="tree">
                            <tree editable="bottom">
                                <field name="product_id"/>
                                <field name="lote_id" domain="[('product_id','=',product_id)]"/>
                                <field name="cantidad"/>
                            </tree>
                        </field>    
                    </page>   
                </page>    
            </field>
        </record>

        <record model="ir.ui.view" id="quemen_view_picking_type_form">
            <field name="name">Quemen Operation Types</field>
            <field name="model">stock.picking.type</field>
            <field name="inherit_id" ref="stock.view_picking_type_form"/>
            <field name="arch" type="xml">
                <field name="warehouse_id" position="after">
                    <group string="Quemen extras">
                        <field name="tipo_operacion_caducidad_id"/>
                        <!-- <field name="porciones"/> -->
                        <field name="tipo_operacion_porcion_id"/>
                        <field name="picking_partner_id"/>
                        <field name="tipo_transporte"/>
                        <field name="salida_traspaso"/>
                        <field name="generar_nuevos_lotes"/>
                        <field name="bloqueo_traspaso"/>
                    </group>
                </field>
            </field>
        </record>

        <record model="ir.ui.view" id="view_stock_quant_tree_editable_quemen">
            <field name="name">stock.quant.tree.editable.quemen</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
            <field name="arch" type="xml">
                <field name="product_id" position="before">
                    <field name="referencia_interna"/>
                </field>
                <xpath expr="//field[@name='inventory_quantity_auto_apply']" position="before">
                    <field name="expiration_date" optional="show" invisible="context.get('removal_date')" attrs="{'readonly': ['|', ('tracking', '=', 'none'), ('use_expiration_date', '=', False)]}"/>
                </xpath>
            </field>
        </record>


        <record model="ir.ui.view" id="quemen_stock_move_line_detailed_operation_tree">
            <field name="name">stock.move.line.detailded.operation.tree</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
            <field name="arch" type="xml">
                <field name="product_id" position="before">
                    <field name="barcode"/>
                </field>
            </field>
        </record>



